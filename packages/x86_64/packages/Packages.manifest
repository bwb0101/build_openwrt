Depends: libc
Source: feeds/packages/libs/confuse
SourceName: confuse
License: ISC
LicenseFiles: LICENSE
Section: libs
SourceDateEpoch: 1781370677
CPE-ID: cpe:/a:libconfuse_project:libconfuse
